<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClinicalDataExplorer</RootNamespace>
    <AssemblyName>ClinicalDataExplorer</AssemblyName>
    <Title>Clinical Data Explorer</Title>
    <Product>Clinical Data Explorer</Product>
    <RazorLangVersion>Latest</RazorLangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime files must also be present when launching from the build folder. -->
    <Content Update="wwwroot\**\*;appsettings*.json;App_Data\application-settings.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <None Remove="XSLT\**\*" />
    <Content Include="XSLT\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Include SDK/package assets as well as this project's wwwroot files.
       Production launches do not use the development package-cache manifest. -->
  <Target Name="CopyFrameworkAssetsToBuildOutput"
          BeforeTargets="CopyStaticWebAssetsToOutputDirectory"
          DependsOnTargets="LoadStaticWebAssetsBuildManifest">
    <ItemGroup>
      <StaticWebAsset Update="@(StaticWebAsset)"
                      Condition="'%(StaticWebAsset.AssetKind)' != 'Publish'"
                      CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
