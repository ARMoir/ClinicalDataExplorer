@namespace ClinicalDataExplorer.Components.Pages
@page "/patient/{PatientId}"
@implements IDisposable
@inject FhirService FhirService
@inject XsltService XsltService
@inject ApplicationSettingsService SettingsService
@inject UserActivityService Activity

<PageTitle>@($"{SettingsService.Current.ProductName} - Patient Report")</PageTitle>
<div class="report-page-actions"><a class="secondary-link" href="/">← Patients</a><PrintReport Text="Print visible pages" /></div>
<h1>Patient report</h1>
@if (Loading) { <div class="empty-state" role="status">Loading demographics…</div> }
@if (PatientError is not null) { <div class="error-card" role="alert">@PatientError</div> }
@((MarkupString)PatientHtml)
@if (!Loading && PatientError is null)
{
    <SavePatient PatientId="@PatientId" @key="PatientId" />
    <section class="report-customization search-card">
        <h2>Patient records</h2>
        <p>@Sections.Sum(s => s.Count) records received. Each category loads independently, requesting 50 records per server page. Open another category to load it. Counts reflect only records received so far.</p>
        <p>Linked supporting records are available through the links within each record.</p>
        <p role="status">@EnrichmentStatus</p>
        <div class="report-controls">
            <label class="report-section-search" for="resource-filter">Find a section <input id="resource-filter" data-audit="PatientReport:SectionFilter" @bind="Filter" @bind:event="oninput" placeholder="e.g. visits or medications" /></label>
            <button class="secondary-button" data-audit="PatientReport:ExpandVisibleSections" @onclick="ExpandVisible">Expand loaded sections</button>
            <button class="secondary-button" data-audit="PatientReport:CollapseAllSections" @onclick="CollapseAll">Collapse all</button>
            <label class="report-empty-toggle"><input data-audit="PatientReport:ShowEmptySections" type="checkbox" @bind="ShowEmpty" /> Show types with no returned records</label>
        </div>
        <details class="section-picker"><summary data-audit="PatientReport:ChooseSections">Choose sections for this report</summary><div class="section-choices">@foreach (var section in Sections) { <label><input data-audit="PatientReport:SectionVisibility" type="checkbox" checked="@(!Hidden.Contains(section.ResourceType))" @onchange="() => ToggleVisibility(section)" /> @section.Label</label> }</div></details>
    </section>
    @foreach (var section in VisibleSections)
    {
        <section class="patient-resource-section" @key="section.ResourceType">
            <h2><button class="resource-toggle" data-audit="PatientReport:ToggleSection" aria-expanded="@(section.Expanded ? "true" : "false")" aria-controls="@($"resources-{section.ResourceType}")" @onclick="() => Toggle(section)"><span>@section.Label</span><span class="resource-count">@Status(section)</span><span aria-hidden="true">@(section.Expanded ? "−" : "+")</span></button></h2>
            <div id="@($"resources-{section.ResourceType}")" hidden="@(!section.Expanded)">
                @if (section.Expanded)
                {
                    @foreach (var source in SectionSources(section))
                    {
                        @if (source.Loading) { <p role="status">Loading @ResourcePresentation.Label(source.ResourceType)…</p> }
                        @if (source.Error is not null) { <div class="error-card" role="alert">@ResourcePresentation.Label(source.ResourceType): @source.Error This category is incomplete; records already received remain available.</div> }
                        @if (source.HasMore)
                        {
                            <button class="secondary-button" data-audit="PatientReport:LoadMoreSection" disabled="@source.Loading" @onclick="() => LoadMoreAsync(source)">@(source.Error is not null ? "Retry" : source.Loaded ? "Load more" : "Load") @ResourcePresentation.Label(source.ResourceType)</button>
                        }
                    }
                    @if (section.Count > 0)
                    {
                        @((MarkupString)(section.Html ?? ""))
                        <nav class="pagination" aria-label="@($"{section.Label} pages")"><button data-audit="PatientReport:PreviousSectionPage" class="secondary-button" disabled="@(section.Page == 0)" @onclick="() => ChangePage(section, -1)">← Previous</button><span>Records @(section.Page * 10 + 1)–@Math.Min((section.Page + 1) * 10, section.Count) of @section.Count</span><button data-audit="PatientReport:NextSectionPage" class="secondary-button" disabled="@((section.Page + 1) * 10 >= section.Count)" @onclick="() => ChangePage(section, 1)">Next →</button></nav>
                    }
                    else if (SectionSources(section).All(s => s.Loaded && !s.HasMore && s.Error is null)) { <p>No records returned.</p> }
                }
            </div>
        </section>
    }
    <p class="report-footnote">Print includes expanded sections and their currently visible record pages.</p>
}

@code {
    [Parameter] public string PatientId { get; set; } = string.Empty;
    private CancellationTokenSource? Request;
    private readonly SemaphoreSlim LoadSlots = new(3);
    private IReadOnlyList<System.Xml.Linq.XElement> EnrichedResources = [];
    private string EnrichmentStatus = "Additional linked records will be checked after the initial categories load.";
    private string PatientHtml = "", Filter = "";
    private string? PatientError;
    private bool Loading = true, ShowEmpty, LoadInitialCategories;
    private IReadOnlyList<PatientResourceSection> Sections = [];
    private Dictionary<string, PatientResourceLoad> Sources = new(StringComparer.Ordinal);
    private readonly HashSet<string> Hidden = new(StringComparer.Ordinal);
    private IEnumerable<PatientResourceSection> VisibleSections => Sections.Where(s => !Hidden.Contains(s.ResourceType) &&
        (ShowEmpty || s.Count > 0 || SectionSources(s).Any(p => p.HasMore || p.Loading || p.Error is not null)) &&
        (s.Label.Contains(Filter, StringComparison.OrdinalIgnoreCase) || s.ResourceType.Contains(Filter, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<PatientResourceLoad> SectionSources(PatientResourceSection section) => Sources.Values.Where(s =>
        s.ResourceType == section.ResourceType || (section.ResourceType == "DocumentReference" && s.ResourceType == "Observation"));
    private string Status(PatientResourceSection section) => SectionSources(section).Any(s => s.Error is not null) ? $"{section.Count} · incomplete" :
        SectionSources(section).Any(s => s.Loading) ? $"{section.Count} · loading" :
        SectionSources(section).Any(s => !s.Loaded) ? (section.Count > 0 ? $"{section.Count} · category not searched" : "Not loaded") :
        SectionSources(section).Any(s => s.HasMore) ? $"{section.Count}+" : section.Count.ToString();
    protected override Task OnParametersSetAsync() => ReloadAsync();
    private async Task ReloadAsync()
    {
        Request?.Cancel(); Request?.Dispose();
        Request = new CancellationTokenSource();
        var token = Request.Token;
        EnrichedResources = [];
        EnrichmentStatus = "Additional linked records will be checked after the initial categories load.";
        Loading = true; LoadInitialCategories = false; PatientError = null; PatientHtml = ""; Sections = []; Hidden.Clear();
        Sources = FhirService.PatientResourceTypes.Split(' ').ToDictionary(t => t, t => new PatientResourceLoad(t));
        try
        {
            var xml = await FhirService.GetPatientXmlAsync(PatientId, token);
            if (token.IsCancellationRequested) return;
            PatientHtml = XsltService.Transform("PatientDetails", xml, SettingsService.Current);
            Loading = false;
            UpdateSections();
            LoadInitialCategories = true;
            StateHasChanged();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { if (!token.IsCancellationRequested) PatientError = ex.Message; }
        finally { if (!token.IsCancellationRequested) Loading = false; }
    }
    // OnAfterRender runs only once interactive: prerender must not wait for every category.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!LoadInitialCategories) return;
        LoadInitialCategories = false;
        var token = Request!.Token;
        var patientId = PatientId;
        var sources = Sources;
        await Task.WhenAll(new[] { "Encounter", "Condition", "AllergyIntolerance", "MedicationRequest", "MedicationStatement", "DiagnosticReport", "DocumentReference", "Observation", "Procedure", "Immunization" }
            .Select(t => LoadSourceAsync(sources[t])));
        if (token.IsCancellationRequested) return;
        EnrichmentStatus = "Checking for additional linked records in the background…";
        StateHasChanged();
        try
        {
            var complete = await FhirService.EnrichPatientResourcesAsync(patientId, sections =>
            {
                if (!token.IsCancellationRequested)
                {
                    EnrichedResources = sections.SelectMany(s => s.Resources).ToList();
                    UpdateSections();
                    StateHasChanged();
                }
                return Task.CompletedTask;
            }, token, async budgetToken =>
            {
                // A foreground request may finish the page already in flight, but no new
                // enrichment page starts while any section is queued or loading.
                while (sources.Values.Any(s => s.Loading)) await Task.Delay(100, budgetToken);
            }, LoadSlots);
            if (!token.IsCancellationRequested)
                EnrichmentStatus = complete ? "Additional linked-record check finished. Counts reflect records received."
                    : "Additional linked-record check is incomplete. Any extra records received have been kept.";
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        finally { if (!token.IsCancellationRequested) StateHasChanged(); }
    }
    private void UpdateSections()
    {
        var previous = Sections.ToDictionary(s => s.ResourceType);
        var sections = PatientSectionGrouping.Merge(Sources.Values.SelectMany(s => s.Resources), EnrichedResources).ToList();
        foreach (var type in Sources.Keys)
            if (!sections.Any(s => s.ResourceType == type)) sections.Add(new(type, []));
        for (var i = 0; i < sections.Count; i++)
        {
            if (!previous.TryGetValue(sections[i].ResourceType, out var old)) continue;
            old.UpdateResources(sections[i].Resources);
            if (old.Expanded) Render(old);
            sections[i] = old;
        }
        Sections = sections.OrderBy(s => ResourcePresentation.PatientSectionOrder(s.ResourceType)).ThenBy(s => s.Label).ToList();
    }
    private async Task LoadSourceAsync(PatientResourceLoad source)
    {
        if (source.Loading || !source.HasMore || Request is null) return;
        var token = Request.Token;
        var patientId = PatientId;
        source.Loading = true; source.Error = null;
        StateHasChanged();
        var entered = false;
        try
        {
            await LoadSlots.WaitAsync(token); entered = true;
            await FhirService.LoadPatientResourcePageAsync(patientId, source, token);
            if (!token.IsCancellationRequested) UpdateSections();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) { if (!token.IsCancellationRequested) source.Error = ex.Message; }
        finally
        {
            if (entered) LoadSlots.Release();
            source.Loading = false;
            if (!token.IsCancellationRequested) StateHasChanged();
        }
    }
    private async Task LoadMoreAsync(PatientResourceLoad source)
    {
        await AuditSectionAsync("SectionLoadMore", source.ResourceType);
        await LoadSourceAsync(source);
    }
    private void Render(PatientResourceSection section) => section.Html = XsltService.Transform("PatientResources", section.PageXml(), SettingsService.Current, new Dictionary<string, string> { ["resourceLabel"] = section.Label });
    private Task AuditSectionAsync(string action, string details) => Activity.RecordAsync(action, "Patient/" + PatientId, "Requested", details);
    private async Task Toggle(PatientResourceSection section)
    {
        await AuditSectionAsync("SectionToggle", section.ResourceType);
        section.Expanded = !section.Expanded;
        if (section.Expanded) { Render(section); await Task.WhenAll(SectionSources(section).Where(s => !s.Loaded).Select(LoadSourceAsync)); }
    }
    private async Task ChangePage(PatientResourceSection section, int delta) { await AuditSectionAsync("SectionPage", section.ResourceType); section.Page += delta; Render(section); }
    private async Task ExpandVisible() { await AuditSectionAsync("SectionsExpand", "Loaded sections"); foreach (var section in VisibleSections.Where(s => s.Count > 0)) { section.Expanded = true; Render(section); } }
    private async Task CollapseAll() { await AuditSectionAsync("SectionsCollapse", "All"); foreach (var section in Sections) section.Expanded = false; }
    private async Task ToggleVisibility(PatientResourceSection section) { await AuditSectionAsync("SectionVisibility", section.ResourceType); if (!Hidden.Add(section.ResourceType)) Hidden.Remove(section.ResourceType); }
    public void Dispose() { Request?.Cancel(); Request?.Dispose(); }
}
