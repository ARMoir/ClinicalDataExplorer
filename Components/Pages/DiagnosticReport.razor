@namespace ClinicalDataExplorer.Components.Pages
@page "/diagnostic-report"
@inject FhirService FhirService
@inject XsltService XsltService
@inject ApplicationSettingsService SettingsService

<PageTitle>@($"{SettingsService.Current.ProductName} - Diagnostic Report")</PageTitle>
<h1>Diagnostic Report</h1>
<section class="search-card"><label for="diagnostic-id">DiagnosticReport identifier</label><div class="search-row"><input id="diagnostic-id" @bind="Identifier" @bind:event="oninput" @onkeydown="HandleKeyDown"/><button @onclick="LoadAsync" disabled="@(Loading || string.IsNullOrWhiteSpace(Identifier))">@(Loading ? "Loading..." : "Create report")</button></div></section>
@if (ErrorMessage is not null) { <div class="error-card" role="alert">@ErrorMessage</div> }
@if (!string.IsNullOrWhiteSpace(ReportHtml)) { <div class="report-page-actions"><button class="secondary-button" onclick="window.print()">Print</button></div><section class="viewer-card">@((MarkupString)ReportHtml)</section> }

@code {
    private string Identifier { get; set; } = string.Empty;
    private string ReportHtml { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool Loading { get; set; }
    private async Task HandleKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") await LoadAsync(); }
    private async Task LoadAsync()
    {
        if (Loading || string.IsNullOrWhiteSpace(Identifier)) return;
        Loading = true; ErrorMessage = null; ReportHtml = string.Empty;
        try { var response = await FhirService.GetDiagnosticReportBundleXmlAsync(Identifier); ReportHtml = XsltService.TransformDiagnosticReportBundle(response.Xml, SettingsService.Current); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
        finally { Loading = false; }
    }
}
