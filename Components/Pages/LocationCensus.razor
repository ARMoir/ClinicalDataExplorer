@namespace ClinicalDataExplorer.Components.Pages
@page "/location-census"
@page "/census"
@implements IDisposable
@inject FhirService FhirService
@inject ApplicationSettingsService SettingsService

<PageTitle>@($"{SettingsService.Current.ProductName} - Census")</PageTitle>
<div class="page-header">
    <div><h1>Census</h1><p>Current encounters and patients by location, ordered by newest encounter start date. Encounters within each location are newest first.</p></div>
</div>
<p>Includes arrived, triaged, in-progress and on-leave encounters whose period has not ended. Only current location assignments are shown. An encounter may appear at more than one location.</p>
<section class="search-card census-filters" aria-label="Choose census locations">
    <h2>Choose locations</h2>
    <p>Select the locations to include, then load the census.</p>
    <div class="search-row">
        <button type="button" data-audit="Census:SelectAll" @onclick="SelectAll" disabled="@(Busy || Locations.Count == 0)">Select all</button>
        <button type="button" data-audit="Census:ClearSelection" @onclick="ClearSelection" disabled="@(Busy || SelectedKeys.Count == 0)">Clear selection</button>
        <button type="button" data-audit="Census:LoadLocations" @onclick="LoadLocationsAsync" disabled="@Busy">Reload locations</button>
    </div>
    <div class="census-location-options">
        @foreach (var location in Locations)
        {
            <label class="census-empty-toggle" @key="location.Key">
                <input type="checkbox" data-audit="Census:SelectLocation" checked="@SelectedKeys.Contains(location.Key)"
                       @onchange="e => SetSelected(location.Key, e.Value is true)" disabled="@Busy" />
                <span>@location.Name <small>(@location.Key)</small></span>
            </label>
        }
    </div>
    <p role="status">@SelectedKeys.Count of @Locations.Count locations selected</p>
    <button type="button" data-audit="LocationCensus:Refresh" @onclick="LoadAsync" disabled="@(Busy || SelectedKeys.Count == 0)">@(LoadedAt is null ? "Load census" : "Refresh census")</button>
</section>
@if (LoadedAt is not null)
{
<section class="search-card census-filters" aria-label="Census filters">
    <label for="census-search">Search locations or patients</label>
    <div class="search-row">
        <input id="census-search" type="search" data-audit="Census:Search" @bind="Search" @bind:event="oninput"
               placeholder="Location, patient name, or patient identifier / MRN" autocomplete="off" aria-describedby="census-search-help" />
        <button type="button" data-audit="Census:ClearFilters" @onclick="ClearFilters" disabled="@(Search.Length == 0 && !HideEmpty)">Clear filters</button>
    </div>
    <p id="census-search-help">Matching locations show all their encounters. Patient matches show only matching patients.</p>
    <label class="census-empty-toggle" for="census-hide-empty">
        <input id="census-hide-empty" type="checkbox" data-audit="Census:HideEmpty" @bind="HideEmpty" /> Hide empty locations
    </label>
</section>
}
@if (Busy)
{
    <div class="empty-state" role="status">@LoadingMessage</div>
}
else if (Error is not null)
{
    <div class="error-card" role="alert">@Error</div>
}
else if (LoadedAt is null)
{
    <div class="empty-state">@(Locations.Count == 0 ? "No locations were returned. Reload locations to try again." : "Choose one or more locations and select Load census.")</div>
}
else
{
    var visibleGroups = FilteredGroups();
    <p role="status">Showing @visibleGroups.Count of @Groups.Count locations / groups · @EncounterCount(visibleGroups) of @EncounterCount(Groups) current encounters · Loaded @LoadedAt?.ToLocalTime().ToString("g")</p>
    @if (Groups.Count == 0) { <div class="empty-state">No locations or current encounters were returned.</div> }
    else if (visibleGroups.Count == 0) { <div class="empty-state">No locations or patients match these filters. Clear filters to see the full census.</div> }
    @foreach (var group in visibleGroups)
    {
        <section class="viewer-card census-location" @key="group.Key">
            <h2>@group.Name</h2>
            <p>@group.Key · @(group.Status ?? "Status not supplied") · @group.Encounters.Count current encounters shown</p>
            @if (group.Encounters.Count == 0) { <p>No current encounters at this location.</p> }
            else
            {
                <div class="table-wrap">
                    <table class="results-table">
                        <caption class="sr-only">Current encounters at @group.Name</caption>
                        <thead><tr><th scope="col">Encounter</th><th scope="col">Patient</th><th scope="col">Status</th><th scope="col">Started</th></tr></thead>
                        <tbody>
                            @foreach (var row in group.Encounters)
                            {
                                <tr>
                                    <td><a href="@("/encounter/" + Uri.EscapeDataString(row.Encounter.Id))">@row.Encounter.Id</a><div>@row.Encounter.Type</div><small>@string.Join(" · ", row.Encounter.Identifiers)</small></td>
                                    <td>
                                        @if (row.PatientId is not null) { <a href="@("/patient/" + Uri.EscapeDataString(row.PatientId))">@row.PatientDisplay</a> }
                                        else { <span>@row.PatientDisplay</span> }
                                        @if (row.PatientId is not null) { <SavePatient PatientId="@row.PatientId" @key="row.PatientId" /> }
                                        @if (row.Patient is { } patient) { <div>@string.Join(" · ", patient.Identifiers)</div><small>Born: @(patient.BirthDate ?? "Not recorded")</small> }
                                        else { <div>Patient details unavailable</div> }
                                    </td>
                                    <td>@row.Encounter.Status</td>
                                    <td>@(row.Encounter.Start?.ToLocalTime().ToString("g") ?? "Not recorded")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

@code {
    private readonly CancellationTokenSource Lifetime = new();
    private IReadOnlyList<LocationCensusGroup> Groups = [];
    private IReadOnlyList<LocationCensusGroup> Locations = [];
    private readonly HashSet<string> SelectedKeys = new(StringComparer.Ordinal);
    private string LoadingMessage = "Loading locations…";
    private bool Busy;
    private string? Error;
    private DateTimeOffset? LoadedAt;
    private string Search = "";
    private bool HideEmpty = true;
    private void ClearFilters() { Search = ""; HideEmpty = false; }
    private static int EncounterCount(IReadOnlyList<LocationCensusGroup> groups) =>
        groups.SelectMany(g => g.Encounters).Select(r => r.Encounter.Id).Distinct(StringComparer.Ordinal).Count();

    private IReadOnlyList<LocationCensusGroup> FilteredGroups()
    {
        var query = Search.Trim();
        bool Matches(string? value) => value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
        var result = new List<LocationCensusGroup>();
        foreach (var group in Groups)
        {
            if (HideEmpty && group.Encounters.Count == 0) continue;
            if (query.Length == 0 || Matches(group.Name) || Matches(group.Key))
                result.Add(group);
            else
            {
                var rows = group.Encounters.Where(row => Matches(row.PatientDisplay) || Matches(row.PatientId) ||
                    row.Patient?.Identifiers.Any(Matches) == true).ToList();
                if (rows.Count > 0) result.Add(group with { Encounters = rows });
            }
        }
        return result;
    }
    private void ResetCensus() { Groups = []; LoadedAt = null; Error = null; }
    private void SetSelected(string key, bool selected)
    {
        if (selected) SelectedKeys.Add(key); else SelectedKeys.Remove(key);
        ResetCensus();
    }
    private void SelectAll() { SelectedKeys.UnionWith(Locations.Select(l => l.Key)); ResetCensus(); }
    private void ClearSelection() { SelectedKeys.Clear(); ResetCensus(); }
    protected override Task OnInitializedAsync() => LoadLocationsAsync();
    private async Task LoadLocationsAsync()
    {
        Busy = true;
        LoadingMessage = "Loading locations…";
        ResetCensus();
        try
        {
            Locations = await FhirService.GetCensusLocationsAsync(Lifetime.Token);
            SelectedKeys.IntersectWith(Locations.Select(l => l.Key));
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Error = "Unable to load locations. " + ex.Message; }
        finally { Busy = false; }
    }
    private async Task LoadAsync()
    {
        if (SelectedKeys.Count == 0) return;
        Busy = true;
        LoadingMessage = "Loading census…";
        ResetCensus();
        try
        {
            Groups = await FhirService.GetLocationCensusAsync(Lifetime.Token,
                Locations.Where(l => SelectedKeys.Contains(l.Key)).ToList());
            LoadedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException) when (Lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Error = "Unable to load the census. " + ex.Message; }
        finally { Busy = false; }
    }
    public void Dispose() { Lifetime.Cancel(); Lifetime.Dispose(); }
}
