@namespace ClinicalDataExplorer.Components
@inject IWebHostEnvironment HostEnvironment
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@AppStylesheetUrl" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <div id="connection-startup" class="error-card" role="status" hidden>
        Interactive controls are not connected yet. If this message remains, reload the page and check the browser console for connection errors.
        <button type="button" onclick="window.location.reload()">Reload page</button>
    </div>
    <Routes @rendermode="InteractiveServer" />
    <div id="blazor-error-ui" class="error-card" role="alert" style="display:none">
        The interactive session encountered an error. Reload the page to reconnect. If it happens again, contact an administrator to check the server logs.
        <button type="button" onclick="window.location.reload()">Reload page</button>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="connection-startup.js"></script>
</body>
</html>

@code {
    // A changed stylesheet gets a new URL so browsers do not retain old layout rules.
    private string AppStylesheetUrl => $"app.css?v={HostEnvironment.WebRootFileProvider.GetFileInfo("app.css").LastModified.UtcTicks}";
}
