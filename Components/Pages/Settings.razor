@namespace ClinicalDataExplorer.Components.Pages
@page "/settings"
@inject ApplicationSettingsService SettingsService
@inject NavigationManager Navigation
@inject UserActivityService Activity

<PageTitle>@($"{Form.ProductName} - Settings")</PageTitle>

<div class="page-header settings-page-header">
    <h1>Application Settings</h1>
    <p>Configure the product identity, authentication, facility branding, data connection, and report appearance.</p>
</div>

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="success-card" role="status">@SuccessMessage</div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="error-card" role="alert"><strong>Settings error</strong><div>@ErrorMessage</div></div>
}

@if (Allowed)
{
<EditForm Model="Form" OnValidSubmit="SaveAsync" FormName="application-settings">
    <DataAnnotationsValidator />
    <ValidationSummary role="alert" />

    <section class="settings-card">
        <div class="settings-card-heading"><h2>Administrators</h2><p>Administrators can change settings and review audit records.</p></div>
        <label><InputCheckbox id="all-users-administrators" @bind-Value="Form.AllUsersAreAdministrators" /> All users are administrators</label>
        <p>Enabled by default for initial setup, including anonymous users when authentication is disabled.</p>
        <div class="settings-field"><label for="administrator-users">Administrator Windows accounts</label><InputTextArea id="administrator-users" @bind-Value="Form.AdministratorUsers" rows="4" placeholder="DOMAIN\username (one account per line)" /><small>When the option above is off, only these authenticated accounts are administrators. Include your own account to retain access.</small></div>
    </section>

    <section class="settings-card">
        <div class="settings-card-heading">
            <h2>Application</h2>
            <p>The product name is the user-facing application title. It can be changed without renaming or rebuilding the project.</p>
        </div>

        <div class="settings-grid">
            <div class="settings-field settings-field-wide">
                <label for="productName">Product name</label>
                <InputText id="productName" @bind-Value="Form.ProductName" placeholder="Clinical Data Explorer" />
                <ValidationMessage For="@(() => Form.ProductName)" />
            </div>
        </div>
    </section>

    <section class="settings-card">
        <div class="settings-card-heading">
            <h2>Authentication</h2>
            <p>Windows mode uses the active Windows/Active Directory account supplied by the host. Clinical Data Explorer never receives or stores the user's AD password.</p>
        </div>

        <div class="settings-grid">
            <div class="settings-field">
                <label for="authenticationMode">Authentication mode</label>
                <InputSelect id="authenticationMode" @bind-Value="Form.AuthenticationMode">
                    <option value="Windows">Windows / Active Directory</option>
                    <option value="Disabled">Disabled (development only)</option>
                </InputSelect>
                <ValidationMessage For="@(() => Form.AuthenticationMode)" />
            </div>

            <div class="settings-field">
                <label for="windowsDomain">Windows domain (optional)</label>
                <InputText id="windowsDomain" @bind-Value="Form.WindowsDomain" placeholder="e.g. EMERSON" />
                <ValidationMessage For="@(() => Form.WindowsDomain)" />
                <small>Leave blank initially. If set, only identities from this domain are allowed. No domain-controller address or service account is required.</small>
            </div>
        </div>

        <div class="settings-info">
            For IIS deployment, enable <strong>Windows Authentication</strong> and disable <strong>Anonymous Authentication</strong>.
            Authentication-setting changes force a full page reload so the browser can renegotiate the Windows identity.
        </div>
    </section>

    <section class="settings-card">
        <div class="settings-card-heading">
            <h2>Facility</h2>
            <p>This branding appears in the application header and report output.</p>
        </div>

        <div class="settings-grid">
            <div class="settings-field settings-field-wide">
                <label for="facilityName">Facility name</label>
                <InputText id="facilityName" @bind-Value="Form.FacilityName" />
                <ValidationMessage For="@(() => Form.FacilityName)" />
            </div>

            <div class="settings-field settings-field-wide">
                <label for="facility-logo-file">Logo</label>
                <div class="logo-setting-row">
                    <div class="logo-preview" style="@PreviewThemeStyle">
                        @if (!string.IsNullOrWhiteSpace(Form.LogoPath))
                        {
                            <img src="@Form.LogoPath" alt="Facility logo preview" />
                        }
                        else
                        {
                            <span>No logo</span>
                        }
                    </div>

                    <div class="logo-actions">
                        <InputFile id="facility-logo-file" OnChange="UploadLogoAsync" accept="image/png,image/jpeg,image/webp" />
                        <small>PNG, JPG, or WebP. Maximum 5 MB.</small>
                        @if (!string.IsNullOrWhiteSpace(Form.LogoPath))
                        {
                            <button data-audit="Settings:RemoveLogo" type="button" class="secondary-button" @onclick="RemoveLogo">Remove logo</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="settings-card">
        <div class="settings-card-heading">
            <h2>Data connection</h2>
            <p>The server address used to retrieve clinical records. Changes take effect as soon as settings are saved.</p>
        </div>

        <div class="settings-grid">
            <div class="settings-field settings-field-wide">
                <label for="fhirBaseUrl">Server base URL</label>
                <InputText id="fhirBaseUrl" @bind-Value="Form.FhirBaseUrl" placeholder="http://summittest:8080/" />
                <ValidationMessage For="@(() => Form.FhirBaseUrl)" />
                <small>Use the server root or service base path, for example http://summittest:8080/ or https://server.example.org/fhir/.</small>
            </div>
        </div>
    </section>

    <section class="settings-card">
        <div class="settings-card-heading">
            <h2>Colors</h2>
            <p>Primary is used for buttons and report accents. Secondary is used for the application header and strong UI elements.</p>
        </div>

        <div class="color-settings-grid">
            <div class="settings-field">
                <label for="primaryColor">Primary color</label>
                <div class="color-input-row">
                    <input data-audit="Settings:PrimaryColor" id="primaryColorPicker" aria-label="Choose primary color" type="color" @bind="Form.PrimaryColor" />
                    <InputText id="primaryColor" @bind-Value="Form.PrimaryColor" />
                </div>
                <ValidationMessage For="@(() => Form.PrimaryColor)" />
            </div>

            <div class="settings-field">
                <label for="secondaryColor">Secondary color</label>
                <div class="color-input-row">
                    <input data-audit="Settings:SecondaryColor" id="secondaryColorPicker" aria-label="Choose secondary color" type="color" @bind="Form.SecondaryColor" />
                    <InputText id="secondaryColor" @bind-Value="Form.SecondaryColor" />
                </div>
                <ValidationMessage For="@(() => Form.SecondaryColor)" />
            </div>
        </div>

        <div class="theme-preview" style="@PreviewThemeStyle">
            <div class="theme-preview-header">
                @if (!string.IsNullOrWhiteSpace(Form.LogoPath))
                {
                    <img src="@Form.LogoPath" alt="" />
                }
                <span class="brand-text">
                    <strong>@Form.FacilityName</strong>
                    <span>@Form.ProductName</span>
                </span>
            </div>
            <div class="theme-preview-body">
                <span class="theme-preview-pill">FINAL</span>
                <button data-audit="Settings:PreviewAction" type="button">Example action</button>
            </div>
        </div>
    </section>

    <div class="settings-actions">
        <button data-audit="Settings:SaveSettings" type="submit" class="primary-button" disabled="@Saving">@(Saving ? "Saving..." : "Save settings")</button>
        <a class="secondary-link" href="/">Back to report viewer</a>
    </div>
</EditForm>
}

@code {
    private ApplicationSettings Form { get; set; } = new();
    private bool Saving { get; set; }
    private bool Allowed;
    private string? SuccessMessage { get; set; }
    private string? ErrorMessage { get; set; }
    private string OriginalAuthenticationMode { get; set; } = "Windows";
    private string OriginalWindowsDomain { get; set; } = "";

    private string PreviewThemeStyle =>
        $"--primary-color:{AccessibleTheme.Color(Form.PrimaryColor, "#1F618D")};--secondary-color:{AccessibleTheme.Color(Form.SecondaryColor, "#17202A")};";

    protected override async Task OnInitializedAsync()
    {
        try { await Activity.RequireAdministratorAsync(); Allowed = true; }
        catch (UnauthorizedAccessException ex) { ErrorMessage = ex.Message; return; }
        Form = SettingsService.Current;
        OriginalAuthenticationMode = Form.AuthenticationMode;
        OriginalWindowsDomain = Form.WindowsDomain;
    }

    private async Task UploadLogoAsync(InputFileChangeEventArgs args)
    {
        SuccessMessage = null;
        ErrorMessage = null;

        try
        {
            await Activity.RequireAdministratorAsync();
            await Activity.RecordAsync("LogoUpload", "/settings", "Attempted");
            Form.LogoPath = await SettingsService.SaveLogoAsync(args.File);
            await Activity.RecordAsync("LogoUpload", "/settings", "Succeeded");
        }
        catch (Exception ex)
        {
            await Activity.RecordAsync("LogoUpload", "/settings", "Failed", ex.GetType().Name);
            ErrorMessage = ex.Message;
        }
    }

    private async Task RemoveLogo()
    {
        await Activity.RequireAdministratorAsync();
        await Activity.RecordAsync("LogoRemoval", "/settings", "Staged");
        Form.LogoPath = null;
        SuccessMessage = "Logo will be removed when you save settings.";
        ErrorMessage = null;
    }

    private async Task SaveAsync()
    {
        Saving = true;
        SuccessMessage = null;
        ErrorMessage = null;

        try
        {
            await Activity.RequireAdministratorAsync();
            if (!Form.AllUsersAreAdministrators && Form.AdministratorUsers.Split(['\r', '\n', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length == 0)
                throw new InvalidOperationException("Specify at least one administrator before turning off administrator access for all users.");
            var current = SettingsService.Current;
            static object? AuditValue(System.Reflection.PropertyInfo property, ApplicationSettings value) =>
                property.Name == nameof(ApplicationSettings.FhirBaseUrl) ? "Connection changed (URL values omitted)" : property.GetValue(value);
            var changes = typeof(ApplicationSettings).GetProperties()
                .Where(p => !Equals(p.GetValue(current), p.GetValue(Form)))
                .ToDictionary(p => p.Name, p => new { Before = AuditValue(p, current), After = AuditValue(p, Form) });
            await Activity.RecordAsync("SettingsChange", "/settings", "Attempted", System.Text.Json.JsonSerializer.Serialize(changes));
            var authenticationChanged =
                !string.Equals(OriginalAuthenticationMode, Form.AuthenticationMode, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(OriginalWindowsDomain?.Trim(), Form.WindowsDomain?.Trim(), StringComparison.OrdinalIgnoreCase);

            await SettingsService.SaveAsync(Form);
            await Activity.RecordAsync("SettingsChange", "/settings", "Succeeded");
            Form = SettingsService.Current;
            Allowed = await Activity.IsAdministratorAsync();
            OriginalAuthenticationMode = Form.AuthenticationMode;
            OriginalWindowsDomain = Form.WindowsDomain;

            if (authenticationChanged)
            {
                Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
                return;
            }

            SuccessMessage = "Settings saved. The new settings are now active.";
        }
        catch (Exception ex)
        {
            await Activity.RecordAsync("SettingsChange", "/settings", "Failed", ex.GetType().Name);
            ErrorMessage = ex.Message;
        }
        finally
        {
            Saving = false;
        }
    }
}
