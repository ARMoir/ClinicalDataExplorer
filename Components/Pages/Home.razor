@namespace ClinicalDataExplorer.Components.Pages
@page "/"
@implements IDisposable
@inject FhirService FhirService
@inject ApplicationSettingsService SettingsService

<PageTitle>@($"{SettingsService.Current.ProductName} - Patients")</PageTitle>

<div class="page-header patient-page-header">
    <div>
        <h1>Patients</h1>
        <p>Find a patient by identifier or select one of the 10 patients with the most recent encounters.</p>
    </div>
    <button class="secondary-button" @onclick="LoadNewestPatientsAsync" disabled="@Busy">
        Refresh newest
    </button>
</div>

<section class="search-card">
    <label for="patient-identifier">Patient identifier</label>
    <div class="search-row">
        <input id="patient-identifier"
               @bind="Identifier"
               @bind:event="oninput"
               @onkeydown="HandleSearchKeyDown"
               placeholder="MRN, medical record number, or other identifier"
               autocomplete="off" />
        <button @onclick="SearchAsync" disabled="@(Busy || string.IsNullOrWhiteSpace(Identifier))">
            @(Searching ? "Searching..." : "Search")
        </button>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="error-card" role="alert">
        <strong>FHIR request failed</strong>
        <p>@ErrorMessage</p>
    </div>
}

<div class="patient-workspace">
    <section class="patient-list-card">
        <div class="card-heading-row">
            <div>
                <h2>@PatientListTitle</h2>
                <span>@PatientListSubtitle</span>
            </div>
            @if (LoadingPatients)
            {
                <span class="loading-label">Loading...</span>
            }
        </div>

        @if (!LoadingPatients && Patients.Count == 0)
        {
            <div class="empty-state">No matching patients were returned.</div>
        }
        else
        {
            <div class="patient-list">
                @foreach (var patient in Patients)
                {
                    <button class="patient-row @(SelectedPatient?.Id == patient.Id ? "selected" : null)"
                            @onclick="() => SelectPatientAsync(patient)"
                            disabled="@Busy">
                        <span class="patient-row-main">
                            <strong>@patient.DisplayName</strong>
                            <span>@FormatIdentifiers(patient.Identifiers)</span>
                        </span>
                        <span class="patient-row-meta">
                            <span>DOB @Display(patient.BirthDate)</span>
                            <span>@Display(patient.Gender)</span>
                            @if (!ShowingSearchResults)
                            {
                                <span>Latest encounter @FormatDate(patient.MostRecentEncounter)</span>
                            }
                            else
                            {
                                <span>Updated @FormatDate(patient.LastUpdated)</span>
                            }
                        </span>
                    </button>
                }
            </div>
        }
    </section>

    <section class="encounter-card">
        @if (SelectedPatient is null)
        {
            <div class="encounter-placeholder">
                <strong>Select a patient</strong>
                <span>Their complete encounter history will appear here.</span>
            </div>
        }
        else
        {
            <div class="selected-patient-header">
                <div>
                    <span class="eyebrow">Selected patient</span>
                    <h2>@SelectedPatient.DisplayName</h2>
                    <p>@FormatIdentifiers(SelectedPatient.Identifiers)</p>
                    <a class="xslt-report-link" href="@($"/patient/{Uri.EscapeDataString(SelectedPatient.Id)}")">Open customizable patient report</a>
                </div>
                <span class="encounter-count">@Encounters.Count encounter@(Encounters.Count == 1 ? "" : "s")</span>
            </div>

            @if (LoadingEncounters)
            {
                <div class="empty-state">Loading all encounters...</div>
            }
            else if (Encounters.Count == 0)
            {
                <div class="empty-state">No encounters were returned for this patient.</div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="encounter-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Class</th>
                                <th>Status</th>
                                <th>Observations</th>
                                <th>Location / provider</th>
                                <th>Identifier</th>
                                <th>Report</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var encounter in Encounters)
                            {
                                <tr>
                                    <td>
                                        <strong>@FormatDate(encounter.Start)</strong>
                                        @if (encounter.End is not null)
                                        {
                                            <small>to @FormatDate(encounter.End)</small>
                                        }
                                    </td>
                                    <td>@encounter.Type</td>
                                    <td>@encounter.Class</td>
                                    <td><span class="status-chip">@encounter.Status</span></td>
                                    <td>
                                        <button class="observation-count-button @(SelectedEncounter?.Id == encounter.Id ? "active" : null)"
                                                @onclick="() => SelectEncounterAsync(encounter)"
                                                disabled="@(LoadingObservations || encounter.ObservationCount == 0)">
                                            @encounter.ObservationCount
                                        </button>
                                    </td>
                                    <td>@encounter.LocationOrProvider</td>
                                    <td class="identifier-cell">@FormatIdentifiers(encounter.Identifiers)</td>
                                    <td><a class="xslt-report-link" href="@($"/encounter/{Uri.EscapeDataString(encounter.Id)}")">Report</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (SelectedEncounter is not null)
            {
                <section class="observations-panel">
                    <div class="observations-heading">
                        <div>
                            <span class="eyebrow">Encounter observations</span>
                            <h3>@FormatDate(SelectedEncounter.Start) · @SelectedEncounter.Type</h3>
                        </div>
                        <button class="secondary-button" @onclick="CloseObservations" disabled="@LoadingObservations">Close</button>
                    </div>

                    @if (LoadingObservations)
                    {
                        <div class="empty-state">Loading observations...</div>
                    }
                    else if (Observations.Count == 0)
                    {
                        <div class="empty-state">No observations were returned.</div>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table class="observation-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Observation</th>
                                        <th>Value</th>
                                        <th>Interpretation</th>
                                        <th>Reference range</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var observation in Observations)
                                    {
                                        <tr>
                                            <td>@FormatDate(observation.EffectiveDate)</td>
                                            <td><strong>@observation.Name</strong></td>
                                            <td class="observation-value">@observation.Value</td>
                                            <td>@Display(observation.Interpretation)</td>
                                            <td>@Display(observation.ReferenceRange)</td>
                                            <td><span class="status-chip">@observation.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            }
        }
    </section>
</div>

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private IReadOnlyList<PatientSummary> Patients { get; set; } = [];
    private IReadOnlyList<EncounterSummary> Encounters { get; set; } = [];
    private IReadOnlyList<ObservationSummary> Observations { get; set; } = [];
    private PatientSummary? SelectedPatient { get; set; }
    private EncounterSummary? SelectedEncounter { get; set; }
    private string Identifier { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool LoadingPatients { get; set; }
    private bool LoadingEncounters { get; set; }
    private bool Searching { get; set; }
    private bool LoadingObservations { get; set; }
    private bool ShowingSearchResults { get; set; }
    private string SearchedIdentifier { get; set; } = string.Empty;
    private bool Busy => LoadingPatients || LoadingEncounters || Searching || LoadingObservations;
    private string PatientListTitle => ShowingSearchResults ? "Search results" : "Recent patients";
    private string PatientListSubtitle => ShowingSearchResults
        ? $"Identifier: {SearchedIdentifier}"
        : "Ordered by most recent encounter";

    protected override async Task OnInitializedAsync() => await LoadNewestPatientsAsync();

    private async Task LoadNewestPatientsAsync()
    {
        LoadingPatients = true;
        ShowingSearchResults = false;
        ErrorMessage = null;
        SelectedPatient = null;
        Encounters = [];
        CloseObservations();

        try
        {
            Patients = await FhirService.GetPatientsWithRecentEncountersAsync(_cancellation.Token);
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested) { }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            Patients = [];
        }
        finally
        {
            LoadingPatients = false;
        }
    }

    private async Task SearchAsync()
    {
        if (Busy || string.IsNullOrWhiteSpace(Identifier)) return;

        Searching = true;
        ShowingSearchResults = true;
        SearchedIdentifier = Identifier.Trim();
        ErrorMessage = null;
        SelectedPatient = null;
        Encounters = [];
        CloseObservations();

        try
        {
            Patients = await FhirService.SearchPatientsByIdentifierAsync(Identifier, _cancellation.Token);
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested) { }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            Patients = [];
        }
        finally
        {
            Searching = false;
        }
    }

    private async Task SelectPatientAsync(PatientSummary patient)
    {
        if (Busy) return;

        SelectedPatient = patient;
        Encounters = [];
        CloseObservations();
        LoadingEncounters = true;
        ErrorMessage = null;

        try
        {
            Encounters = await FhirService.GetPatientEncountersAsync(patient.Id, _cancellation.Token);
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested) { }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            LoadingEncounters = false;
        }
    }

    private async Task SelectEncounterAsync(EncounterSummary encounter)
    {
        if (LoadingObservations || encounter.ObservationCount == 0) return;

        SelectedEncounter = encounter;
        Observations = [];
        LoadingObservations = true;
        ErrorMessage = null;

        try
        {
            Observations = await FhirService.GetEncounterObservationsAsync(encounter.Id, _cancellation.Token);
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested) { }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            LoadingObservations = false;
        }
    }

    private void CloseObservations()
    {
        SelectedEncounter = null;
        Observations = [];
        LoadingObservations = false;
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await SearchAsync();
    }

    private static string FormatIdentifiers(IReadOnlyList<string> identifiers) =>
        identifiers.Count == 0 ? "No identifier" : string.Join(" · ", identifiers);

    private static string Display(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;

    private static string FormatDate(DateTimeOffset? date) =>
        date?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not recorded";

    public void Dispose()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
