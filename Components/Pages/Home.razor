@namespace ClinicalDataExplorer.Components.Pages
@page "/"
@implements IAsyncDisposable
@inject FhirService FhirService
@inject ApplicationSettingsService SettingsService
@inject UserActivityService Activity

<PageTitle>@($"{SettingsService.Current.ProductName} - Patients")</PageTitle>
<div class="patient-directory">
    <div class="page-header patient-page-header">
        <div><span class="eyebrow">Patient directory</span><h1>Find your patient</h1><p>Search patient records or browse by most recent encounter.</p></div>
        <button data-audit="Home:RefreshRecentPatients" class="secondary-button" @onclick="LoadRecentAsync" disabled="@Busy">Refresh recent patients</button>
    </div>
    <section class="search-card" aria-label="Patient search">
        <div class="search-mode">
            <label for="search-mode">Search by</label>
            <select data-audit="Home:SearchMode" id="search-mode" @bind="SearchMode" disabled="@Busy"><option value="identifier">Patient identifier / MRN</option><option value="name">Last and first name</option></select>
        </div>
        <form data-audit="Home:SearchPatients" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <div class="search-row directory-search">
                @if (SearchMode == "identifier")
                {
                    <div><label for="patient-identifier">Patient identifier</label><input data-audit="Home:PatientIdentifier" id="patient-identifier" @bind="Identifier" @bind:event="oninput" placeholder="MRN or other identifier" autocomplete="off" disabled="@Busy" /></div>
                }
                else
                {
                    <div><label for="patient-family">Last name</label><input data-audit="Home:PatientFamily" id="patient-family" @bind="Family" @bind:event="oninput" placeholder="Last name" autocomplete="off" disabled="@Busy" /></div>
                    <div><label for="patient-given">First name</label><input data-audit="Home:PatientGiven" id="patient-given" @bind="Given" @bind:event="oninput" placeholder="First name" autocomplete="off" disabled="@Busy" /></div>
                }
                <button data-audit="Home:SubmitSearch" type="submit" disabled="@(Busy || !CanSearch)">@(Busy ? "Loading…" : "Search patients")</button>
            </div>
        </form>
        @if (SearchMode == "name") { <p class="search-help">Enter either name or both to narrow your search.</p> }
    </section>
    @if (ErrorMessage is not null) { <div class="error-card" role="alert">@ErrorMessage <button data-audit="Home:RetrySearch" class="secondary-button" @onclick="RetryAsync" disabled="@Busy">Retry</button></div> }
    <section class="patient-list-card directory-results" aria-busy="@(Busy ? "true" : "false")">
        <div class="card-heading-row"><div><h2>@(IsSearch ? "Search results" : "Recent patients")</h2><span>@ListDescription</span></div><span>5 per page</span></div>
        @if (Busy) { <div class="empty-state" role="status">Loading patients…</div> }
        else if (CurrentPatients.Count == 0 && ErrorMessage is null) { <div class="empty-state">No matching patients were returned.</div> }
        else
        {
            <div class="patient-list">
                @for (var patientIndex = 0; patientIndex < CurrentPatients.Count; patientIndex++)
                {
                    var patient = CurrentPatients[patientIndex];
                    var avatarColor = patientIndex % 2 == 0 ? "var(--primary-color)" : "var(--secondary-color)";
                    <article class="patient-row directory-patient" @key="patient.Id">
                        <div class="directory-identity"><span class="patient-avatar" style="background-color: @avatarColor" aria-hidden="true">@patient.Initials</span><div><h3><a href="@($"/patient/{Uri.EscapeDataString(patient.Id)}")">@patient.DisplayName</a></h3><span>@(patient.Identifiers.Count > 0 ? string.Join(" · ", patient.Identifiers) : "No identifier recorded")</span></div><span class="status-chip">@(patient.Active == false ? "Inactive" : "Active")</span></div>
                        <dl class="directory-demographics">
                            <div><dt>Date of birth</dt><dd>@Display(patient.BirthDate)</dd></div><div><dt>Gender</dt><dd>@Display(patient.Gender)</dd></div>
                            <div><dt>Phone</dt><dd>@Display(patient.Phone)</dd></div><div><dt>@(IsSearch ? "Last updated" : "Latest encounter")</dt><dd>@((IsSearch ? patient.LastUpdated : patient.MostRecentEncounter)?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not recorded")</dd></div>
                            <div class="directory-address"><dt>Address</dt><dd>@Display(patient.Address)</dd></div><div><dt>Email</dt><dd>@Display(patient.Email)</dd></div><div><dt>Record ID</dt><dd>@patient.Id</dd></div>
                        </dl>
                        <ProviderList Providers="patient.Practitioners" Error="@patient.PractitionerLookupError" Incomplete="@(patient.PractitionerStatus == PractitionerAssociationStatus.Incomplete)" />
                        <a class="patient-open" href="@($"/patient/{Uri.EscapeDataString(patient.Id)}")">Open patient report →</a>
                    </article>
                }
            </div>
        }
        <nav class="pagination" aria-label="Patient pages">
            <button data-audit="Home:PreviousPage" class="secondary-button" @onclick="PreviousPage" disabled="@(Busy || Page == 0)">← Previous</button>
            <span aria-live="polite">Page @(Page + 1) · @CurrentPatients.Count patients</span>
            <button data-audit="Home:NextPage" class="secondary-button" @onclick="NextPageAsync" disabled="@(Busy || ErrorMessage is not null || (Page + 1 >= Pages.Count && !HasMore))">Next →</button>
        </nav>
    </section>
    @if (!IsSearch) { <p class="search-help">Recent patients have a loading limit per patient. Slow records may be skipped or have incomplete provider details. Search for a patient specifically to wait for their record.</p> }
</div>

@code {
    private readonly CancellationTokenSource Cancellation = new();
    private IAsyncEnumerator<PatientSummary>? Iterator;
    private readonly List<IReadOnlyList<PatientSummary>> Pages = [];
    private PatientSummary? Lookahead;
    private int Page;
    private bool Busy, IsSearch, HasMore;
    private string SearchMode = "identifier", Identifier = "", Family = "", Given = "";
    private string ListDescription = "Ordered by most recent encounter", ActiveIdentifier = "", ActiveFamily = "", ActiveGiven = "";
    private string? ErrorMessage;
    private bool CanSearch => SearchMode == "identifier" ? !string.IsNullOrWhiteSpace(Identifier) : !string.IsNullOrWhiteSpace(Family) || !string.IsNullOrWhiteSpace(Given);
    private IReadOnlyList<PatientSummary> CurrentPatients => Pages.Count > Page ? Pages[Page] : [];
    protected override Task OnInitializedAsync() => LoadRecentAsync();
    private Task LoadRecentAsync() { IsSearch = false; ListDescription = "Ordered by most recent encounter"; return ResetAsync(); }
    private Task SearchAsync()
    {
        if (Busy || !CanSearch) return Task.CompletedTask;
        IsSearch = true;
        ActiveIdentifier = SearchMode == "identifier" ? Identifier.Trim() : "";
        ActiveFamily = SearchMode == "name" ? Family.Trim() : "";
        ActiveGiven = SearchMode == "name" ? Given.Trim() : "";
        ListDescription = SearchMode == "identifier" ? $"Identifier: {ActiveIdentifier}" : $"Name: {ActiveFamily}, {ActiveGiven}";
        return ResetAsync();
    }
    private Task RetryAsync() => ResetAsync();
    private async Task ResetAsync()
    {
        Busy = true;
        try
        {
            if (Iterator is not null) await Iterator.DisposeAsync();
            Pages.Clear(); Page = 0; Lookahead = null; HasMore = true; ErrorMessage = null;
            Iterator = (IsSearch ? FhirService.StreamPatientSearchAsync(ActiveIdentifier, ActiveFamily, ActiveGiven, Cancellation.Token)
                : FhirService.StreamRecentPatientsAsync(Cancellation.Token)).GetAsyncEnumerator(Cancellation.Token);
            await ReadPageAsync();
        }
        catch (OperationCanceledException) when (Cancellation.IsCancellationRequested) { }
        catch (Exception ex) { ErrorMessage = ex.Message; HasMore = false; }
        finally { Busy = false; }
    }
    private async Task ReadPageAsync()
    {
        var patients = new List<PatientSummary>();
        if (Lookahead is not null) { patients.Add(Lookahead); Lookahead = null; }
        while (patients.Count < 5 && await Iterator!.MoveNextAsync()) patients.Add(Iterator.Current);
        HasMore = patients.Count == 5 && await Iterator!.MoveNextAsync();
        if (HasMore) Lookahead = Iterator!.Current;
        // Bound concurrent full-record requests; enrich only the visible page,
        // not the lookahead patient or the rest of the search result set.
        var enriched = new List<PatientSummary>();
        foreach (var batch in patients.Chunk(5))
            enriched.AddRange(await Task.WhenAll(batch.Select(p => IsSearch
                ? FhirService.AddPatientPractitionersAsync(p, Cancellation.Token)
                : FhirService.AddRecentPatientPractitionersAsync(p, Cancellation.Token))));
        Pages.Add(enriched);
    }
    private async Task PreviousPage() { await Activity.RecordAsync("PatientPage", "/", "Requested", "Page " + Page); if (Page > 0) Page--; }
    private async Task NextPageAsync()
    {
        if (Busy) return;
        await Activity.RecordAsync("PatientPage", "/", "Requested", "Page " + (Page + 2));
        if (Page + 1 < Pages.Count) { Page++; return; }
        Busy = true;
        try { await ReadPageAsync(); Page++; }
        catch (OperationCanceledException) when (Cancellation.IsCancellationRequested) { }
        catch (Exception ex) { ErrorMessage = ex.Message; HasMore = false; }
        finally { Busy = false; }
    }
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    public async ValueTask DisposeAsync()
    {
        await Cancellation.CancelAsync();
        // An in-flight MoveNextAsync owns the enumerator until cancellation completes.
        if (!Busy && Iterator is not null) await Iterator.DisposeAsync();
        Cancellation.Dispose();
    }
}
